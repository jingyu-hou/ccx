CFLAGS = -g -pg -Wall -O0 -fno-pie  -I ../SPOOLES.2.2 -DARCH="Linux" -DSPOOLES -DARPACK -DMATRIXSTORAGE -DNETWORKOUT
FFLAGS = -g -pg -Wall -O0 -fallow-argument-mismatch  -I ../lapack-3.2.1 -DARCH="Linux" -DLAPACK

CC=gcc
FC=gfortran

.c.o :
	$(CC) $(CFLAGS) -c $<
.f.o :
	$(FC) $(FFLAGS) -c $<

include Makefile.inc

SCCXMAIN = WeICME.c

OCCXF = $(SCCXF:.f=.o)
OCCXC = $(SCCXC:.c=.o)
OCCXMAIN = $(SCCXMAIN:.c=.o)

DIR=../SPOOLES.2.2

LIBS = \
       $(DIR)/spooles.a \
	../ARPACK/libarpack_REDHAT.a \
	../lapack-3.2.1/liblapackREDHAT.a \
	../lapack-3.2.1/libblasREDHAT.a \
       -lpthread -lm -lc

WeICME: $(OCCXMAIN) WeICME.a  $(LIBS)
	./date.pl; $(CC) $(CFLAGS) -c WeICME.c; $(FC)  -Wall -O3 -no-pie -o $@ $(OCCXMAIN) WeICME.a $(LIBS)

WeICME.a: $(OCCXF) $(OCCXC)
	ar vr $@ $?

clean:
	rm *.o *.a
