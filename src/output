+      subroutine calcresvfluid1(n,a,b,au,ia,ja,x,res)
+!
+      implicit none
+!
+      integer i,j,n,ia(*),ja(*)
+!
+      real*8 a(*),b(*),au(*),x(*),res,resi,vel
+!
