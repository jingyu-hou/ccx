+      subroutine materialdata_th_h2(cocon,ncocon,imat,iorien,pgauss,
+     &  orab,ntmat_,coconloc,mattyp,t1l,rhcon,nrhcon,rho,shcon,nshcon,
+     &  sph,xstiff,iint,iel,istiff,mi,xstateini,nstate_,nelcon,
