+               vfa(0,i)=vfap(0,i)
+            else
+!     
+!     flux given: gradient=flux
+!     
+               indexf=ipnei(iel1)+ielfa(4,i)
+               vfa(0,i)=vel(iel1,0)
+     &              +(gradtfa(1,i)*xxi(1,indexf)+
+     &              gradtfa(2,i)*xxi(2,indexf)+
+     &              gradtfa(3,i)*xxi(3,indexf))*xle(indexf)
+            endif
+         else
+!     
+!     zero gradient
+!     
+            vfa(0,i)=vel(iel1,0)
+         endif
+      enddo
+!            
+      return
+      end
