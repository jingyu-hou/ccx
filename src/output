@@ -0,0 +1,125 @@
+/*                                                                              */
+/*      WeICME (Wedge Integrated Computational Materials Engineering)           */
+/*                 - A 3-dimensional finite element program.                    */   
+/*     Developed and maintained by Shenzhen Wedge Central                       */
+/*    South Research Institute co., Ltd., Shenzhen, China                       */   
+/*     Copy Right 2019-2023.                                                      */
+
+#include <stdio.h>
+#include <math.h> 
+#include <stdlib.h>
+#include "WeICME.h"
+#ifdef SPOOLES
+   #include "spooles.h"
+#endif
+#ifdef SGI
+   #include "sgi.h"
+#endif
+#ifdef TAUCS
+   #include "tau.h"
+#endif
+
+
+void calcresidual_h(ITG *nmethod, ITG *neq, double *b, double *fext, double *f,
+        ITG *iexpl, ITG *nactdof, double *aux2, double *vold,
+        double *vini, double *dtime, double *accold, ITG *nk, double *adb,
+        double *aub, ITG *jq, ITG *irow, ITG *nzl, double *alpha,
+        double *fextini, double *fini, ITG *islavnode, ITG *nslavnode,
+        ITG *mortar, ITG *ntie,double *f_cm,
+	double* f_cs, ITG *mi,ITG *nzs,ITG *nasym,ITG *idamping,
+        double *veold,double *adc,double *auc,double *cvini,double *cv,
+		double *enthaold, double *enthaini, ITG ienthabased, double *adl){
+
+    ITG j,k,mt=mi[1]+1;
+    double scal1;
+      
+    /* residual for a static analysis */
+      
+    if(*nmethod!=4){
+	for(k=0;k<neq[1];++k){
+	    b[k]=fext[k]-f[k];
+	}
+    }
+      
+    /* residual for implicit dynamics */
+      
+    else if(*iexpl<=1){
+	for(k=0;k<*nk;++k){
+	    if(nactdof[mt*k]>0){
+			if(ienthabased==1)
+				aux2[nactdof[mt*k]-1]=(enthaold[k]-enthaini[k])/(*dtime);
+				//printf("node%d,old=%f,ini=%f,aux2=%f\n",k,enthaold[k],enthaini[k],aux2[nactdof[mt*k]-1]);
+				//printf("temp: ,old=%f,ini=%f\n",k,vold[mt*k],vini[mt*k]);
+				//printf("eq%d: dof on node %d\n",nactdof[mt*k],k);
+			else
+				aux2[nactdof[mt*k]-1]=(vold[mt*k]-vini[mt*k])/(*dtime);
+		}
+	    for(j=1;j<mt;++j){
+		if(nactdof[mt*k+j]>0){aux2[nactdof[mt*k+j]-1]=accold[mt*k+j];}
+	    }
+	}
+	/*if(*nasym==0){
+	    FORTRAN(op,(&neq[1],aux2,b,adb,aub,jq,irow)); 
+	}else{
+	    FORTRAN(opas,(&neq[1],aux2,b,adb,aub,jq,irow,nzs)); 
+	}*/
+	scal1=1.+*alpha;
+	for(k=0;k<neq[0];++k){
+	    b[k]=scal1*(fext[k]-f[k])-*alpha*(fextini[k]-fini[k])-b[k];
+	} 
+	for(k=neq[0];k<neq[1];++k){
+		//printf("eq%d: fext[k]=%f, f[k]=%f, b[k]=%f\n",k,fext[k],f[k],b[k]);
+		//printf("eq%d: time derivative term=%E\n",k,-b[k]);
+	    //b[k]=fext[k]-f[k]-b[k];
+		//printf("eq%d: time derivative term=%E\n",k,-aux2[k]*adl[k]);
+	    b[k]=fext[k]-f[k]-aux2[k]*adl[k];
+		//printf("      diffusion=%E, load=%E, total rhs=%E\n",-f[k],fext[k],b[k]);
+	} 
+
+	/* correction for damping */
+
+	if(*idamping==1){
+	    for(k=0;k<*nk;++k){
+		if(nactdof[mt*k]>0){aux2[nactdof[mt*k]-1]=0.;}
+		for(j=1;j<mt;++j){
+		    if(nactdof[mt*k+j]>0){
+			aux2[nactdof[mt*k+j]-1]=veold[mt*k+j];}
+		}
+	    }
+	    if(*nasym==0){
+		FORTRAN(op,(&neq[1],aux2,cv,adc,auc,jq,irow));
+	    }else{
+		FORTRAN(opas,(&neq[1],aux2,cv,adc,auc,jq,irow,nzs)); 
+	    }
+	    for(k=0;k<neq[0];++k){
+		b[k]-=scal1*cv[k]-*alpha*cvini[k];
+	    }
+	}
+    }
+
+    /* residual for explicit dynamics */
+    
+    else{
+	for(k=0;k<*nk;++k){
+	    if(nactdof[mt*k]>0){
+			if(ienthabased==1)
+				aux2[nactdof[mt*k]-1]=(enthaold[k]-enthaini[k])/(*dtime);
+				//printf("node%d,old=%f,ini=%f\n",k,enthaold[k],enthaini[k]);
+			else
+				aux2[nactdof[mt*k]-1]=(vold[mt*k]-vini[mt*k])/(*dtime);}
+	    for(j=1;j<mt;++j){
+		if(nactdof[mt*k+j]>0){aux2[nactdof[mt*k+j]-1]=accold[mt*k+j];}
+	    }
+	}
+	scal1=1.+*alpha;
+	for(k=0;k<neq[0];++k){
+	    b[k]=scal1*(fext[k]-f[k])-*alpha*(fextini[k]-fini[k])
+		-adb[k]*aux2[k];
+	} 
+	for(k=neq[0];k<neq[1];++k){
+	    b[k]=fext[k]-f[k]-adb[k]*aux2[k];
+	} 
+    }
+
+    return;
+}
