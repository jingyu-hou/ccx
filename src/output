+      is=7;
+      ie=7;
+      FORTRAN(applympc,(nface,ielfa,&is,&ie,ifabou,ipompc,vfa,coefmpc,
+			nodempc,ipnei,neifa,labmpc,xbounact,nactdoh,
+			ifaext,nfaext));
+    }
