+      pthread_create(&tid[i], NULL, (void *)extrapol_vel4mt, (void *)&ithread[i]);
+    }
+    for(i=0; i<*num_cpus; i++)  pthread_join(tid[i], NULL);
+    
+    SFREE(ithread);
+    
+    /* multiple point constraints */
+    
+    if(*nmpc>0){
+      is=1;
+      ie=3;
+      FORTRAN(applympc,(nface,ielfa,&is,&ie,ifabou,ipompc,vfa,coefmpc,
