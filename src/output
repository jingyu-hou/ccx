+     &           (t1l-rhcon(0,id,imat))/
+     &           (rhcon(0,id+1,imat)-rhcon(0,id,imat))
+c            drho=(rhcon(1,id+1,imat)-rhcon(1,id,imat))/
+c     &           (rhcon(0,id+1,imat)-rhcon(0,id,imat))
+            if((rhcon(0,id+1,imat)-t1l).lt.0.1d0) then
+               if(id.eq.(nrhcon(imat)-1)) then
