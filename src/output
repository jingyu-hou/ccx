+  
+}
+
+/* subroutine for multithreading of extrapol_vel1 */
+
+void *extrapol_vel1mt(ITG *i){
+  
+  ITG nfacea,nfaceb,nfacedelta;
+  
+  nfacedelta=(ITG)floor(*nface1/(double)(*num_cpus1));
