+      SFREE(erad);SFREE(ac);SFREE(bc);SFREE(ipiv);
+      SFREE(bcr);SFREE(ipivr);SFREE(adview);SFREE(auview);SFREE(adrad);
+      SFREE(aurad);SFREE(irowrad);SFREE(jqrad);SFREE(icolrad);
