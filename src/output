+		    if(qa1[3+j*4]>qa[3]){qa[3]=qa1[3+j*4];}
+		}
+	    }
+	}
+
+	SFREE(qa1);
+ 	
+	for(j=1;j<num_cpus;j++){
+	    nal[0]+=nal[j];
+	}
+
+	if(calcul_qa==1){
+	    if(nal[0]>0){
