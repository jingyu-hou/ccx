+      if(initial.eq.1) then
+        do i=1,nef
+          indexe=ipkonf(i)
+          if(lakonf(i)(4:4).eq.'8') then
+            nope=8
+          elseif(lakonf(i)(4:4).eq.'6') then
+            nope=6
+          else
+            nope=4
+          endif
