+!     
+         do l=1,ncfd
+            gradpcel(l,i)=0.d0
+         enddo
+!
+         do indexf=ipnei(i)+1,ipnei(i+1)
+            ifa=neifa(indexf)
+            do l=1,ncfd
+               gradpcel(l,i)=gradpcel(l,i)+
+     &              vfap(4,ifa)*xxna(l,indexf)
+            enddo
+         enddo
+!     
+!        dividing by the volume of the element
+!     
+         do l=1,ncfd
+            gradpcel(l,i)=gradpcel(l,i)/volume(i)
+         enddo
+      enddo
