+     &              (t1l-cocon(0,id,imat))/
+     &              (cocon(0,id+1,imat)-cocon(0,id,imat)))
+               coconloc(k)=coconloc(k)*dentha
+            enddo
+         endif
+      
+         if (nelcon(1,imat).eq.-70) then
+            coconloc(1)=coconloc(1)*(2.d0*xstateini(1,iint,iel)/
